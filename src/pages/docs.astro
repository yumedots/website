---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";

const files = (await getCollection("docs")).sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));
const parts = await Promise.all(files.map(render));
const chapters = parts.flatMap(p => p.headings.filter(h => h.depth === 2));
---
<Base title="Documentation · yumedots" description="Keybinds, launcher, bar widgets and config files of the yumedots Hyprland dotfiles.">
  <section class="docs">
    <div class="wrap">
      <div class="head">
        <h1>Documentation</h1>
        <p>Every keybind, and the file to edit when you want to change it.</p>
      </div>
      <div class="doc">
        <nav class="toc" aria-label="Chapters">
          {chapters.map(h => <a href={`#${h.slug}`}>{h.text}</a>)}
        </nav>
        <article class="prose">{parts.map(({ Content }) => <Content />)}</article>
      </div>
    </div>
  </section>
</Base>

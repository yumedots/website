---
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const clone = "git clone --recursive https://github.com/yumedots/dotfiles ~/dotfiles";
const copy = "cp -r ~/dotfiles/* ~/.config/";
---
<Base>
  <section class="hero">
    <canvas id="dots" aria-hidden="true"></canvas>
    <div class="wrap lead">
      <h1>yumedots</h1>
      <p>Hyprland dotfiles by <a href="https://github.com/yumedots">yumedots</a>. Black, flat and fast, ready the moment you log in.</p>
      <div class="cta">
        <a class="btn" href="#install"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg>Get the dotfiles</a>
        <a class="btn ghost" href={`${base}docs/`}>Documentation</a>
      </div>
    </div>
  </section>

  <section class="install" id="install">
    <div class="wrap">
      <div class="head">
        <h2>Install</h2>
        <p>Back up your <code>~/.config</code>, clone, copy, then log into Hyprland. Everything autostarts.</p>
      </div>
      <div class="code">
<pre><span>$ </span>{clone}
<span>$ </span>{copy}</pre>
          <button class="copy-btn" type="button" aria-label="Copy commands" data-copy={`${clone}\n${copy}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M8 8h12v12H8zM4 16V4h12"/></svg><svg class="check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M4 12l5 5L20 6"/></svg></button>
      </div>
      <a class="more" href={`${base}docs/`}>Every keybind is in the documentation <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
  </section>
</Base>

<script src="../scripts/home.js"></script>

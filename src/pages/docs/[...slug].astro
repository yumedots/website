---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const files = (await getCollection("docs")).sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));
  const pages = await Promise.all(files.map(async (entry, i) => {
    const { Content, headings } = await render(entry);
    // The first file is /docs/ itself; the rest drop their order prefix: "2-launcher" -> /docs/launcher/.
    return { slug: i === 0 ? undefined : entry.id.replace(/^\d+-/, ""), title: headings.find(h => h.depth === 2)?.text ?? entry.id, Content };
  }));
  return pages.map((page, i) => ({ params: { slug: page.slug }, props: { page, pages, i } }));
}

const { page, pages, i } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const href = p => `${base}docs/${p.slug ? `${p.slug}/` : ""}`;
const [prev, next] = [pages[i - 1], pages[i + 1]];
---
<Base title={`${page.title} · yumedots`} description={`${page.title}: yumedots Hyprland dotfiles documentation.`} footer={false}>
  <div class="docs">
    <nav class="toc" aria-label="Documentation">
      {pages.map(p => <a href={href(p)} aria-current={p === page ? "page" : undefined}>{p.title}</a>)}
    </nav>
    <div class="page">
      <h1>{page.title}</h1>
      <article class="prose"><page.Content /></article>
      <nav class="pager" aria-label="Pages">
        {prev && <a href={href(prev)} aria-label={`Previous: ${prev.title}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>{prev.title}</a>}
        {next && <a class="next" href={href(next)} aria-label={`Next: ${next.title}`}>{next.title}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>}
      </nav>
    </div>
  </div>
</Base>
